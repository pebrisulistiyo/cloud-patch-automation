# Remote-state backend for CI and shared-bucket use (same flow as aws/).
# Terraform ignores this file until it is copied to backend.tf (gitignored):
#
#   cp backend.tf.example backend.tf
#   cp backend.hcl.example backend.hcl    # bucket + prefix
#   terraform init -backend-config=backend.hcl
#
# Without backend.tf, state stays local (gcp/terraform.tfstate).
terraform {
  backend "gcs" {
    # bucket comes from -backend-config=backend.hcl
    prefix = "cloud-patch-automation/gcp"
  }
}
